# SepraAI v2.7 — Remotion CPU Worker Dockerfile
# Configures Node runtime and Chrome headless dependencies for Remotion rendering.

FROM node:18-slim

WORKDIR /app

# Install system dependencies for headless Chrome
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    ffmpeg \
    chromium \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libgconf-2-4 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    ca-certificates \
    fonts-liberation \
    libappindicator1 \
    libnss3 \
    lsb-release \
    xdg-utils \
    wget \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install python components needed for background tasks and arq orchestration
RUN pip3 install --no-cache-dir --break-system-packages \
    sqlalchemy \
    asyncpg \
    pydantic \
    pydantic-settings \
    pgvector \
    redis \
    arq \
    boto3

# Copy codebase
COPY ./sepraai-backend /app/sepraai-backend
ENV PYTHONPATH=/app/sepraai-backend

# Install Remotion CLI
RUN npm install -g remotion

# Start task queue consumer
CMD ["arq", "orchestration.arq_broker.WorkerSettings"]
