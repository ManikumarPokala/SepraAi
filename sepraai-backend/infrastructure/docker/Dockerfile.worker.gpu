# SepraAI v2.7 — WhisperX & NVENC GPU Worker Dockerfile
# Inherits CUDA runtime stack.

FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

WORKDIR /app

# Non-interactive configuration
ENV DEBIAN_FRONTEND=noninteractive

# Install system utilities, Python, and GPU-compatible ffmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch with CUDA support first, then WhisperX and database utilities
RUN pip3 install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

RUN pip3 install --no-cache-dir \
    git+https://github.com/m-bain/whisperX.git \
    sqlalchemy \
    asyncpg \
    pydantic \
    pydantic-settings \
    pgvector \
    redis \
    arq \
    boto3

# Copy codebase
COPY ./sepraai-backend /app/sepraai-backend
ENV PYTHONPATH=/app/sepraai-backend

# Start GPU worker queue
CMD ["arq", "orchestration.arq_broker.WorkerSettings"]
